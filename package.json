{
  "name": "ngx-devkit-builders",
  "version": "3.0.0",
  "author": {
    "name": "Dominik Hladík",
    "email": "dominik.hladik@seznam.cz",
    "url": "https://github.com/Celtian"
  },
  "private": false,
  "license": "MIT",
  "description": "Custom Angular builders",
  "builders": "builders.json",
  "scripts": {
    "build": "rimraf dist && tsc",
    "postbuild": "bun run script:prepare-dist",
    "build:watch": "tsc-watch --onSuccess 'bun run postbuild'",
    "lint": "eslint 'src/**/*.ts' 'test/**/*.ts' 'vitest.config.ts' --format stylish",
    "test": "vitest run",
    "publish:npmjs": "bun run build && npm publish --folder dist",
    "script:gpr-setup": "bun scripts/gpr-setup.ts",
    "script:prepare-dist": "bun scripts/prepare-dist.ts",
    "prepare": "husky",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "postversion": "git push && git push --follow-tags",
    "publish:beta": "bun install && bun run build && npm publish --folder dist --tag beta",
    "release:beta": "npm version prerelease -m \"chore(update): prelease %s β\"",
    "release:patch": "git checkout master && npm version patch -m \"chore(update): patch release %s 🐛 \"",
    "release:minor": "git checkout master && npm version minor -m \"chore(update): release %s 🚀\"",
    "release:major": "git checkout master && npm version major -m \"chore(update): major release %s 💥 \"",
    "fix-vulnerabilities": "bun update && bun audit"
  },
  "dependencies": {
    "@angular-devkit/architect": "^0.2200.9",
    "@angular-devkit/core": "^22.0.9",
    "@schematics/angular": "^22.0.9",
    "fs-extra": "^11.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.5",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "auto-changelog": "^2.6.0",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "quick-commitlint": "^0.1.0",
    "rimraf": "^6.1.3",
    "tsc-watch": "^7.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  },
  "homepage": "https://github.com/Celtian/ngx-devkit-builders#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Celtian/ngx-devkit-builders.git"
  },
  "keywords": [
    "angular",
    "ngx",
    "builder",
    "devkit"
  ],
  "bugs": {
    "url": "https://github.com/Celtian/ngx-devkit-builders/issues"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24 <26",
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "auto-changelog": {
    "remote": "none",
    "commitUrl": "https://github.com/Celtian/ngx-devkit-builders/commit/{id}",
    "issueUrl": "https://github.com/Celtian/ngx-devkit-builders/issues/{id}",
    "mergeUrl": "https://github.com/Celtian/ngx-devkit-builders/pull/{id}",
    "compareUrl": "https://github.com/Celtian/ngx-devkit-builders/compare/{from}...{to}"
  }
}
